{
  "schema": "qwen4-path-sanitization-v1",
  "date": "2026-11-19",
  "reason": "These repositories are public. No record may publish a user home directory, a workstation path, a model checkpoint mount, a fleet host identity, a machine address or a network interface name. Only identifiers of that kind changed; no measured value, token id, timing, kernel hash or count was edited.",
  "placeholder_scheme": {
    "home directory": "/home/<user>, /Users/<user>",
    "model checkpoint directory": "<checkpoint>",
    "workspace directory": "<workspace>",
    "fleet host, distinct pair": "<host-4090-a>, <host-4090-b>",
    "fleet host, other": "<host-4090> or <host-3090>",
    "machine address": "<ip>",
    "hardware address": "<mac>",
    "network interface": "<iface>"
  },
  "kept_addresses": {
    "reason": "An address that documents the API itself or a standard container network is not an internal host, so it is left as it was.",
    "loopback": "127.0.0.1 (55 occurrences preserved)",
    "bind_any": "0.0.0.0",
    "container_bridge": "172.17.0.0/16"
  },
  "field_names": {
    "replacements": "counts are keyed by a neutral label, never by the replaced string, so this record cannot reintroduce what it documents"
  },
  "hash_policy": "Hashes recorded in the evidence manifest and summaries still name the bytes that were measured (pre-sanitization). This record maps each changed file from that old hash to the hash it has now, so both remain checkable.",
  "matching_rule": "A fleet host identifier is matched with a word boundary on both sides, so an ordinary name such as `tests-20261118.log` is never rewritten as a host.",
